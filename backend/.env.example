# Copy to .env and fill in real values. Every variable here is validated on
# boot by src/config/env.ts — the server exits if a required one is missing.

# --- Database (Neon PostgreSQL) ---
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# --- Redis (Upstash, used by BullMQ) ---
REDIS_URL=rediss://default:password@host.upstash.io:6379

# --- Auth ---
# Both secrets must be at least 32 characters.
JWT_ACCESS_SECRET=replace-with-a-random-32-plus-character-string
JWT_REFRESH_SECRET=replace-with-a-different-random-32-plus-character-string
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Signs waitlist offer links and QR references. At least 32 characters.
HMAC_SECRET=replace-with-another-random-32-plus-character-string

# --- Booking timers (seconds) ---
SEAT_HOLD_TTL_SECONDS=600
WAITLIST_OFFER_TTL_SECONDS=1800

# --- Email (Brevo HTTP API) ---
# SMTP_USER is the verified sender address shown on outgoing mail.
# Without BREVO_API_KEY the app still runs; email sends are skipped with a warning.
SMTP_USER=you@example.com
BREVO_API_KEY=your-brevo-api-key
# Legacy from the Gmail SMTP setup; still accepted by the env schema but unused.
SMTP_PASS=

# --- Server ---
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
